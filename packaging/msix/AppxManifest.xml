<?xml version="1.0" encoding="utf-8"?>
<!--
  Kreate's MSIX manifest, for the Microsoft Store. The identity is the one
  Partner Center reserved for the app (minary.Kreate); build.ps1 fills in
  the version from Cargo.toml.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="minary.Kreate"
    Publisher="CN=C460CD23-2642-4BA2-A332-6F8ADBE54E1F"
    Version="$VERSION$"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Kreate</DisplayName>
    <PublisherDisplayName>minary</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ko-kr" />
  </Resources>

  <Applications>
    <Application Id="Kreate" Executable="kreate.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Kreate"
        Description="A 3D modelling, animation and rendering application."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Square71x71Logo="Assets\SmallTile.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Double-clicking a .kreate file opens it: the path is passed as the
             first argument, which kreate.exe opens. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="kreate">
            <uap:DisplayName>Kreate Document</uap:DisplayName>
            <uap:Logo>Assets\kreate-file.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.kreate</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
